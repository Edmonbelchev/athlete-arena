{
  "expo": {
    "name": "Athlete Arena",
    "slug": "athlete-arena",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/images/logo.png",
    "scheme": "athletearena",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png",
      "bundleIdentifier": "com.athletearena.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Athlete Arena uses the camera to see you during workouts and count repetitions.",
        "NSLocationWhenInUseUsageDescription": "Athlete Arena does not use your location. This description is required because an included library references location APIs.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.athletearena.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Athlete Arena uses the camera to see you during workouts and count repetitions.",
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Athlete Arena uses the camera to see you during workouts and count repetitions.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "react-native-mediapipe-posedetection",
        {
          "assetsPaths": [
            "./assets/models/"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#111111",
          "defaultChannel": "default"
        }
      ],
      "expo-screen-orientation",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "47035c24-fd38-4c7e-943b-edf676906896"
      }
    },
    "owner": "edmonbelchev"
  }
}

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bump when you replace visual_guides/*.webp in Supabase (same filenames)
EXPO_PUBLIC_VISUAL_GUIDE_CACHE_VERSION=1

# From `eas init` / Expo dashboard (required for push token registration)
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

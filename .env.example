EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional manual override when replacing visual_guides/*.webp (auto-bust uses file updated_at)
EXPO_PUBLIC_VISUAL_GUIDE_CACHE_VERSION=

# From `eas init` / Expo dashboard (required for push token registration)
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# RevenueCat public SDK keys (Project → API keys → App-specific keys)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_key
